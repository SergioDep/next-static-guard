{
  "name": "next-static-guard",
  "version": "0.1.0-dev.1",
  "description": "Static analysis of server\u2013client boundaries in Next.js",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "next-static-guard": "dist/cli/main.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "tests/fixtures/guardlab/base",
    "packages/shared"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project integration",
    "test:integration": "vitest run --project integration",
    "test:framework": "vitest run --project framework",
    "bench": "node tests/bench/run.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:comparison": "node tests/comparison/run.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typescript": "6.0.3",
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "@types/node": "24.19.1",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "dependency-cruiser": "18.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioDep/next-static-guard.git"
  },
  "homepage": "https://github.com/SergioDep/next-static-guard#readme",
  "bugs": {
    "url": "https://github.com/SergioDep/next-static-guard/issues"
  },
  "keywords": [
    "nextjs",
    "react",
    "static-analysis",
    "server-components",
    "cli"
  ]
}
