{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(P(0[1-9]|1[0-9]|2[0-4])|N(0[1-9]|1[0-9]|2[0-4])|U(0[1-9]|1[0-2]))$"
    },
    "ruleId": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "NSG001",
            "NSG002",
            "NSG003",
            "NSG004",
            "NSG005",
            "NSG006"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "projectVariant": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "preconditions": {
      "type": "object",
      "properties": {
        "nextVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "reactVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "reactDomVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "typescriptVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "rsc",
              "client-ssr",
              "client-browser",
              "server-function",
              "server-handler",
              "unreachable",
              "unknown"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "nextVersion",
        "reactVersion",
        "reactDomVersion",
        "typescriptVersion",
        "contexts"
      ],
      "additionalProperties": false
    },
    "expectedStatus": {
      "type": "string",
      "enum": [
        "finding",
        "clean",
        "partial"
      ]
    },
    "expectedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "enum": [
              "NSG001",
              "NSG002",
              "NSG003",
              "NSG004",
              "NSG005",
              "NSG006"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "start": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              },
              "end": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "line",
                  "column",
                  "offset"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "file",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "traceSymbols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        "required": [
          "ruleId",
          "severity",
          "confidence",
          "location",
          "symbol",
          "traceSymbols"
        ],
        "additionalProperties": false
      }
    },
    "expectedLimits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unsupported-version",
              "unresolved-import",
              "conditional-resolution",
              "dynamic-config",
              "unsupported-syntax",
              "unknown-value",
              "unknown-phase",
              "source-excluded",
              "source-budget",
              "uncertain-runtime",
              "comparison-incomplete",
              "fingerprint-collision"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                  },
                  "start": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "line",
                      "column",
                      "offset"
                    ],
                    "additionalProperties": false
                  },
                  "end": {
                    "type": "object",
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "offset": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "line",
                      "column",
                      "offset"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "file",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "affectedRules": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NSG001",
                "NSG002",
                "NSG003",
                "NSG004",
                "NSG005",
                "NSG006"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "code",
          "location",
          "affectedRules"
        ],
        "additionalProperties": false
      }
    },
    "correctedCase": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "ruleId",
    "description",
    "projectVariant",
    "preconditions",
    "expectedStatus",
    "expectedFindings",
    "expectedLimits",
    "correctedCase"
  ],
  "additionalProperties": false
}
